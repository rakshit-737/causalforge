{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalforge.dev/schemas/hypothesis.schema.json",
  "title": "CausalForge incident hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "case_id",
    "tenant_id",
    "statement",
    "supporting_observation_ids",
    "required_evidence",
    "disconfirming_evidence",
    "attack_technique_ids",
    "initial_confidence",
    "risk_if_true",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "hypothesis_id": {"type": "string", "format": "uuid"},
    "case_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
    "supporting_observation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "format": "uuid"}
    },
    "required_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "disconfirming_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "attack_technique_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}
    },
    "initial_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "risk_if_true": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "rationale"],
      "properties": {
        "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "supported", "rejected", "insufficient_evidence"]
    }
  }
}
