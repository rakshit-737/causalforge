{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalforge.dev/schemas/knowledge-document.schema.json",
  "title": "CausalForge knowledge document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "tenant_id",
    "title",
    "source",
    "version",
    "license",
    "content_hash",
    "text",
    "metadata"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "document_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": ["string", "null"], "format": "uuid"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "source": {"type": "string", "minLength": 1, "maxLength": 300},
    "version": {"type": "string", "minLength": 1, "maxLength": 120},
    "license": {"type": "string", "minLength": 1, "maxLength": 200},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  }
}
