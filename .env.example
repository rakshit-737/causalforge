CF_ENVIRONMENT=local
CF_DEBUG=false
CF_HOST=127.0.0.1
CF_PORT=8000
CF_LOG_LEVEL=INFO
CF_DATABASE_URL=sqlite:///./causalforge.db
CF_AUTO_CREATE_SCHEMA=false
CF_READINESS_REQUIRE_DATABASE=true
CF_REDIS_URL=redis://127.0.0.1:6379/0
CF_READINESS_REQUIRE_REDIS=false
CF_LAB_ONLY=true
CF_EXTERNAL_NETWORK_ENABLED=false

# Optional PostgreSQL/Redis compose values. These are local development defaults only.
POSTGRES_DB=causalforge
POSTGRES_USER=causalforge
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
REDIS_PORT=6379
